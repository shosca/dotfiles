#!/usr/bin/env python3
"""Focus a herdr Space from a herdr:// link, such as herdr://pr-16562-review.

The desktop entry herdr-open.desktop registers this script as the handler for the herdr URL
scheme, so a link clicked in a browser or chat app switches the running herdr UI to that Space.

The target after herdr:// matches, in order: a Space label, a workspace id, then the base name of
the Space's worktree checkout. Labels come first because the review-queue reports print them. A
bare argument without the scheme works too, which makes the script usable from a shell.

It only focuses the Space inside herdr. It does not raise the terminal window.

`--notify <space> <title> [body]` sends a desktop notification that focuses the Space when you
click it. GNOME Shell does not render links in a notification body, so a click on the notification
fires its "default" action instead, and this script handles that action. notify-send blocks until
the notification is clicked or dismissed, so the script forks and returns at once; a caller such as
a hook never waits on the user.
"""

import json
import os
import subprocess
import sys
from pathlib import PurePosixPath
from urllib.parse import unquote, urlparse


def target_from(arg: str) -> str:
    if arg.startswith("herdr:"):
        url = urlparse(arg)
        return unquote(url.netloc + url.path).strip("/")
    return arg


def find_workspace(target: str, workspaces: list[dict]) -> str | None:
    for key in (
        lambda ws: ws.get("label"),
        lambda ws: ws.get("workspace_id"),
        lambda ws: PurePosixPath(ws.get("worktree", {}).get("checkout_path", "")).name,
    ):
        for ws in workspaces:
            if key(ws) == target:
                return ws["workspace_id"]
    return None


def notify(title: str, body: str) -> None:
    subprocess.run(["herdr", "notification", "show", title, "--body", body], check=False)


def notify_and_focus(target: str, title: str, body: str) -> int:
    if os.fork() > 0:
        return 0
    os.setsid()
    action = subprocess.run(
        ["notify-send", "--app-name=herdr", "-A", "default=Open", title, body],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    if action == "default":
        focus(target)
    os._exit(0)


def main() -> int:
    args = sys.argv[1:]
    if args[:1] == ["--notify"] and len(args) in (3, 4):
        return notify_and_focus(target_from(args[1]), args[2], args[3] if len(args) == 4 else "")
    if len(args) != 1:
        print("usage: herdr-open herdr://<space-label>", file=sys.stderr)
        print("       herdr-open --notify <space-label> <title> [body]", file=sys.stderr)
        return 2
    return focus(target_from(args[0]))


def focus(target: str) -> int:
    listing = subprocess.run(["herdr", "workspace", "list"], capture_output=True, text=True, check=True)
    workspaces = json.loads(listing.stdout)["result"]["workspaces"]
    workspace_id = find_workspace(target, workspaces)
    if workspace_id is None:
        notify("herdr-open", f"No Space named {target}")
        print(f"herdr-open: no Space named {target}", file=sys.stderr)
        return 1
    subprocess.run(["herdr", "workspace", "focus", workspace_id], check=True, stdout=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
