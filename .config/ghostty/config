font-family = "VictorMono Nerd Font Mono"
font-size = 10

# Pick an existing tmux session (fzf chooser), else create the home session
command = /usr/bin/zsh --login

# Ayu Dark (Ghostty bundled; same palette as Empryo's "Ayu Dark")
theme = Ayu
background-opacity = 0.75

# No GTK CSD titlebar (too tall on GNOME); rely on window management keys
# Flat GTK CSD in windowed mode; auto = titlebar auto-hides when fullscreened
window-decoration = auto
gtk-titlebar-hide-when-maximized = true

# Select also copies to CLIPBOARD so ctrl+shift+v matches shift+insert (primary)
copy-on-select = clipboard

# Reload config (default ctrl+shift+, needs comma; this is easier)
keybind = ctrl+shift+r=reload_config

# Paste clipboard, matching ctrl+shift+v
keybind = shift+insert=paste_from_clipboard

# keybind = `>\=new_split:right
# keybind = `>-=new_split:down
# keybind = `>j=goto_split:next
# keybind = `>k=goto_split:previous
# keybind = `>p=previous_tab
# keybind = `>n=next_tab

