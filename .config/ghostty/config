font-family = "VictorMono Nerd Font Mono"
font-size = 10

# Pick an existing tmux session (fzf chooser), else create the home session
command = /usr/bin/zsh --login

# Solarized Dark (craftzdog style)
theme = Solarized Dark Patched
background-opacity = 0.95
background = #031219

# Select also copies to CLIPBOARD so ctrl+shift+v matches shift+insert (primary)
copy-on-select = clipboard

# Reload config (default ctrl+shift+, needs comma; this is easier)
keybind = ctrl+shift+r=reload_config

# Paste clipboard, matching ctrl+shift+v
keybind = shift+insert=paste_from_clipboard

