{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "./osc7501",
    "./herdr-opencode"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "keybinds": {
    "session.first": "ctrl+g,alt+home",
    "session.last": "ctrl+alt+g",
    "input.line.home": "ctrl+a,home",
    "input.line.end": "ctrl+e,end",
    "input.select.line.home": "ctrl+shift+a,shift+home",
    "input.select.line.end": "ctrl+shift+e,shift+end",
    "input.select.buffer.home": "none",
    "input.select.buffer.end": "none"
  },
  "theme": {
    "name": "ayu-dark"
  }
}
